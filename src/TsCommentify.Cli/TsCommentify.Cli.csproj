<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tc</ToolCommandName>
    <PackageId>TsCommentify</PackageId>
    <Version>1.5.0</Version>
    <Authors>Quinntyne Brown</Authors>
    <Description>A CLI tool that automatically generates JSDoc comments for TypeScript functions, methods, getters, setters, classes, interfaces (including their property and method signatures), enums (including their members), and type alias declarations. Uses a real TypeScript-compiler AST (via a bundled Node sidecar) when Node is available, falling back to an in-process parser otherwise. Supports configurable ignore patterns for test files, and optional flags to stamp @deprecated/@obsolete/@internal/@publicApi tags onto top-level declarations.</Description>
    <PackageTags>typescript;comments;documentation;cli;jsdoc;code-generator;interfaces;types;enums;classes;ast;deprecated;annotations</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/QuinntyneBrown/TsCommentify</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/QuinntyneBrown/TsCommentify</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- The Node sidecar tree is managed/copied explicitly below; keep node_modules
         (32MB) and sidecar files out of the SDK's default Compile/None/Content globs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);sidecar\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Restore the sidecar's typescript dependency at build time when it is missing
       (e.g. a fresh clone or CI). Uses the committed package-lock.json via npm ci. -->
  <Target Name="RestoreSidecarNodeModules"
          BeforeTargets="BeforeBuild;GenerateNuspec"
          Condition="!Exists('$(MSBuildProjectDirectory)\sidecar\node_modules\typescript\lib\typescript.js')">
    <Message Importance="high" Text="Restoring sidecar node_modules (npm ci)..." />
    <Exec Command="npm ci --omit=dev" WorkingDirectory="$(MSBuildProjectDirectory)\sidecar" />
  </Target>

  <!-- Ship the sidecar next to the tool: the script, its package.json, and a TRIMMED
       typescript (only the runtime entrypoint lib/typescript.js + package.json — no
       .d.ts, tsc, or tsserver). require('typescript') resolves from node_modules.
       CopyToOutputDirectory places them under the tool's output, which PackAsTool
       then packs into tools/<tfm>/any/ automatically (no explicit PackagePath). -->
  <ItemGroup>
    <Content Include="sidecar\sidecar.js" CopyToOutputDirectory="PreserveNewest" Pack="false" />
    <Content Include="sidecar\package.json" CopyToOutputDirectory="PreserveNewest" Pack="false" />
    <Content Include="sidecar\node_modules\typescript\package.json"
             Link="sidecar\node_modules\typescript\package.json"
             CopyToOutputDirectory="PreserveNewest" Pack="false" />
    <Content Include="sidecar\node_modules\typescript\lib\typescript.js"
             Link="sidecar\node_modules\typescript\lib\typescript.js"
             CopyToOutputDirectory="PreserveNewest" Pack="false" />
  </ItemGroup>

</Project>
